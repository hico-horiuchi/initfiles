{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "askUserQuestionTimeout": "10m",
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude Code"
  },
  "cleanupPeriodDays": 365,
  "disableDeepLinkRegistration": "disable",
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "GIT_CONFIG_GLOBAL": ""
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Glass.aiff",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "model": "opus",
  "permissions": {
    "allow": [
      "Artifact",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__claude_ai_Atlassian_Rovo__atlassian*",
      "mcp__claude_ai_Atlassian_Rovo__fetch*",
      "mcp__claude_ai_Atlassian_Rovo__get*",
      "mcp__claude_ai_Atlassian_Rovo__lookup*",
      "mcp__claude_ai_Atlassian_Rovo__search*",
      "mcp__claude_ai_gmail__get_*",
      "mcp__claude_ai_gmail__list_*",
      "mcp__claude_ai_gmail__search_*",
      "mcp__claude_ai_Google_Calendar__get_*",
      "mcp__claude_ai_Google_Calendar__list_*",
      "mcp__claude_ai_Google_Calendar__search_*",
      "mcp__claude_ai_Google_Calendar__suggest_*",
      "mcp__claude_ai_Google_Drive__download_*",
      "mcp__claude_ai_Google_Drive__get_*",
      "mcp__claude_ai_Google_Drive__list_*",
      "mcp__claude_ai_Google_Drive__read_*",
      "mcp__claude_ai_Google_Drive__search_*",
      "mcp__claude_ai_Slack__slack_get_*",
      "mcp__claude_ai_Slack__slack_list_*",
      "mcp__claude_ai_Slack__slack_read_*",
      "mcp__claude_ai_Slack__slack_search_*",
      "mcp__esa__esa_get_*",
      "mcp__esa__esa_search_*",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read"
    ],
    "ask": [
      "mcp__claude_ai_Atlassian_Rovo__delete*",
      "mcp__claude_ai_gmail__delete_*",
      "mcp__claude_ai_gmail__trash_*",
      "mcp__claude_ai_Google_Calendar__delete_*",
      "mcp__claude_ai_Google_Drive__trash_*",
      "mcp__claude_ai_Slack__slack_delete_*",
      "mcp__esa__esa_archive_*",
      "mcp__esa__esa_delete_*",
      "mcp__github__delete_*"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(~/.config/acli/)",
      "Read(~/.config/gh/)",
      "Read(~/.local/state/gh/)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "BW_PASSWORD"
        },
        {
          "mode": "deny",
          "name": "BW_SESSION"
        },
        {
          "mode": "deny",
          "name": "GIT_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GITHUB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GH_TOKEN"
        }
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "enabled": true,
    "excludedCommands": [
      "docker",
      "nerdctl",
      "podman",
      "kubectl"
    ],
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        "~/ghq/",
        "~/.asdf/",
        "~/.asdfrc",
        "~/.config/acli/",
        "~/.config/git/",
        "~/.config/gh/",
        "~/.local/state/gh/",
        "~/.git-templates/",
        "~/.gitconfig",
        "~/.gitignore"
      ],
      "allowWrite": [
        "~/.config/acli/",
        "~/.config/gh/",
        "~/.local/state/gh/"
      ],
      "denyRead": [
        "~/"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "gist.github.com",
        "raw.githubusercontent.com"
      ],
      "strictAllowlist": true
    }
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60,
    "type": "command"
  },
  "theme": "auto",
  "viewMode": "focus"
}
